# Required: participant-facing CTFd HTTPS origin and numeric RE:CLAIM challenge ID.
# Do not reuse the private mock values from an acceptance deployment.
CTFD_BASE_URL=https://ctf.example.org
CTFD_CHALLENGE_ID=REPLACE_WITH_NUMERIC_CHALLENGE_ID
CTFD_REQUIRE_TEAM=true

# Required for direct TLS termination in the gateway. At event cutover these
# files must cover the actual GATEWAY_DOMAIN, not a staging-only DNS name.
TLS_CERT_FILE=/etc/letsencrypt/live/REPLACE_WITH_GATEWAY_DOMAIN/fullchain.pem
TLS_KEY_FILE=/etc/letsencrypt/live/REPLACE_WITH_GATEWAY_DOMAIN/privkey.pem
# Set only when CTFd uses a private CA.
CTFD_CA_FILE=

# Optional exact-/32 egress overrides. When blank, deploy.sh resolves the
# current CTFd IPv4 A records plus Kubernetes API Service/ready EndpointSlice
# IPs immediately before rendering NetworkPolicy. Pin only when required.
CTFD_EGRESS_CIDRS=
KUBERNETES_API_EGRESS_CIDRS=
KUBERNETES_API_ENDPOINT_EGRESS_CIDRS=

# k3s single-node placement and public service.
K3S_NODE_NAME=
PUBLIC_SERVICE_TYPE=LoadBalancer
PUBLIC_NODE_PORT=31337
LOAD_BALANCER_IP=
# First deploy fail-closed with an operator/server IPv4 /32. An empty range
# publishes K3s ServiceLB immediately and can bypass UFW; use it only in the
# final public cutover together with ALLOW_PUBLIC_SERVICE=1 and the GCP rule.
LOAD_BALANCER_SOURCE_RANGES=
# Set to 1 only for the deliberate final public release (or any NodePort use).
ALLOW_PUBLIC_SERVICE=0

# GATEWAY_DOMAIN should be explicit for the event deployment and is checked
# against TLS_CERT_FILE. SMOKE_CONNECT_HOST may be an IP before DNS switches;
# TLS verification still uses GATEWAY_DOMAIN as SNI. SMOKE_CA_FILE is only
# needed for a private gateway certificate authority.
GATEWAY_DOMAIN=
SMOKE_CONNECT_HOST=
SMOKE_CA_FILE=

# Normally unchanged.
RELEASE_NAME=reclaim
GATEWAY_NAMESPACE=reclaim-gateway
INSTANCE_NAMESPACE=reclaim-instances
ALLOW_SMALL_HOST=0
