KDIR ?= ../build/kernel-6.12.103
RECLAIM_ROUTE_KEY ?= 1
RECLAIM_ROUTE_ARCHIVE ?= 1
RECLAIM_GROUP_DEFICIT_CAP ?= 0
RECLAIM_ROUTE_WORK ?= 0

obj-m += reclaim_v4_release.o
ccflags-y += -I$(src)/../include
ccflags-y += -DRECLAIM_ROUTE_KEY=$(RECLAIM_ROUTE_KEY)
ccflags-y += -DRECLAIM_ROUTE_ARCHIVE=$(RECLAIM_ROUTE_ARCHIVE)
ccflags-y += -DRECLAIM_GROUP_DEFICIT_CAP=$(RECLAIM_GROUP_DEFICIT_CAP)
ccflags-y += -DRECLAIM_ROUTE_WORK=$(RECLAIM_ROUTE_WORK)

.PHONY: all clean
all:
	$(MAKE) -C $(KDIR) M=$(CURDIR) \
		RECLAIM_ROUTE_KEY=$(RECLAIM_ROUTE_KEY) \
		RECLAIM_ROUTE_ARCHIVE=$(RECLAIM_ROUTE_ARCHIVE) \
		RECLAIM_GROUP_DEFICIT_CAP=$(RECLAIM_GROUP_DEFICIT_CAP) \
		RECLAIM_ROUTE_WORK=$(RECLAIM_ROUTE_WORK) modules
clean:
	$(MAKE) -C $(KDIR) M=$(CURDIR) clean
